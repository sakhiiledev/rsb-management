# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://rsb_user:rsb_password@localhost:5432/rsb_management?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ─── BullMQ (inherits REDIS_URL unless overridden) ───────────────────────────
BULL_REDIS_URL="redis://localhost:6379"
